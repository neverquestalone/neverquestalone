<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NeverQuestAlone's hardened-runtime entitlements (BYOK PRD §11.2, SC-9):
     allow-jit only, which V8 needs. Never disable-library-validation,
     allow-dyld-environment-variables or get-task-allow: each would let another
     same-user program borrow the app's identity and read its Keychain items. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>
