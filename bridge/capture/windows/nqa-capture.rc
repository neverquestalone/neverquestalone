// nqa-capture.exe resources (PRD §11.3, DB11): the DPI/asInvoker manifest
// and version information (what Explorer and a signature check show).
// The version is "(unreleased)" and 0,0,0,0 until a release sets both to the
// app's (app/desktop/package.json "version"): a number no release had is never
// shown (tests/byok/capture_windows_decoder_test.mjs holds it to one or the other).
#include <winver.h>

1 24 "nqa-capture.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,4,19,0
PRODUCTVERSION 1,4,19,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "NeverQuestAlone capture helper"
      VALUE "FileVersion", "1.4.19"
      VALUE "InternalName", "nqa-capture"
      VALUE "OriginalFilename", "nqa-capture.exe"
      VALUE "ProductName", "NeverQuestAlone"
      VALUE "ProductVersion", "1.4.19"
      VALUE "LegalCopyright", "MIT"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
