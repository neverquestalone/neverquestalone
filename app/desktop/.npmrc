# Supply chain (public BYOK PRD SC-4, TH16; final review L2-6): a package version must be at least
# 7 days old before npm puts it in the lockfile, so one published minutes ago never reaches a build.
# npm 11.10 and later honor it when the lockfile changes (npm install / update); npm ci installs
# exactly the lockfile.
min-release-age=7
